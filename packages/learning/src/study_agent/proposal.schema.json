{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Study system reconciliation proposal",
  "description": "The only output Codex may produce for a reconciliation run. Codex never writes to the database or to Markdown directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_revision",
    "run_key",
    "summary",
    "operations"
  ],
  "properties": {
    "base_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "The database revision this proposal was built against."
    },
    "run_key": {
      "type": "string",
      "minLength": 1,
      "description": "Idempotency key. Re-applying the same key returns the first result and must not duplicate tasks."
    },
    "confirmation": {
      "type": "string",
      "enum": [
        "none",
        "provisional",
        "confirmed"
      ],
      "default": "none",
      "description": "Whether the week plan in this proposal was confirmed by the student. Use provisional when the student is offline."
    },
    "week_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One short paragraph describing what this run concluded."
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/operation"
      }
    },
    "ambiguities": {
      "type": "array",
      "description": "Genuine ambiguities to ask the student about. Never guess here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "issue_type"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "priority": {
      "type": "string",
      "enum": [
        "must",
        "should",
        "if_time"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "student",
        "agent",
        "external"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "scheduled",
            "waiting"
          ]
        },
        "scheduled_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "priority": {
          "$ref": "#/definitions/priority"
        },
        "waiting_reason": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "next_check_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "week_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "commitment": {
          "type": "string",
          "enum": [
            "confirmed",
            "provisional"
          ]
        },
        "student_confirmed": {
          "type": "boolean",
          "description": "Set when moving a confirmed weekly commitment out of its week is explicitly allowed."
        },
        "change_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Required whenever an existing destination changes."
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "create_task",
            "authorize_task",
            "update_task",
            "supersede_task",
            "cancel_task",
            "add_criterion",
            "satisfy_criterion",
            "add_evidence",
            "complete_task",
            "set_placement",
            "clear_placement",
            "record_miss",
            "bind_observation",
            "ensure_workflow_instance",
            "link_workflow_observation",
            "link_workflow_task",
            "record_assessment",
            "record_issue_result"
          ]
        },
        "task": {
          "type": "string",
          "description": "Task key or task UUID."
        },
        "by": {
          "type": "string",
          "description": "Replacement task for supersede."
        },
        "reason": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "course": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/actor"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "open"
          ]
        },
        "due_at": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "authorization_source": {
          "type": "string",
          "description": "Required to create an open task: an approved workflow step id, a confirmed fact or an explicit student request."
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criterion": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "summary"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "student_confirmation",
                "objective_record",
                "artifact",
                "note"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string"
            }
          }
        },
        "satisfy_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmed": {
          "type": "boolean"
        },
        "observation_id": {
          "type": "string"
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding_status": {
          "type": "string",
          "enum": [
            "bound",
            "ignored",
            "needs_review"
          ]
        },
        "session_key": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "slides",
            "recording",
            "transcript",
            "note",
            "assignment",
            "result",
            "other"
          ]
        },
        "workflow_id": {
          "type": "string"
        },
        "occurrence_key": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "textbook_quiz",
            "lecture_quiz",
            "official_practice",
            "official_quiz",
            "tutorial",
            "exam",
            "other"
          ]
        },
        "attempt_type": {
          "type": "string",
          "enum": [
            "initial",
            "retest"
          ]
        },
        "occurred_at": {
          "type": "string"
        },
        "score_text": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept",
              "issue_type"
            ],
            "properties": {
              "concept": {
                "type": "string",
                "minLength": 1
              },
              "issue_type": {
                "type": "string",
                "enum": [
                  "wrong",
                  "guessed",
                  "cannot_explain",
                  "cannot_start",
                  "other"
                ]
              },
              "next_retest_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        "issue_id": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "failed",
            "passed",
            "uncertain"
          ]
        },
        "placements": {
          "type": "array",
          "description": "Optional placement for tasks created by this operation.",
          "items": {
            "$ref": "#/definitions/placement"
          }
        },
        "placement": {
          "$ref": "#/definitions/placement"
        },
        "kind": {
          "type": "string",
          "enum": [
            "scheduled",
            "waiting"
          ]
        },
        "scheduled_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "priority": {
          "$ref": "#/definitions/priority"
        },
        "waiting_reason": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "next_check_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "week_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "commitment": {
          "type": "string",
          "enum": [
            "confirmed",
            "provisional"
          ]
        },
        "student_confirmed": {
          "type": "boolean",
          "description": "Set when moving a confirmed weekly commitment out of its week is explicitly allowed."
        },
        "change_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Required whenever an existing destination changes."
        }
      }
    }
  }
}
